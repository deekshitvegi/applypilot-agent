# Copy to .env only if you want to override defaults. Nothing here is required:
# the API key is entered in the extension's Settings panel and stored encrypted.
#
# NEVER commit a real .env. This repository is public.

# Where the encrypted database and the key file live. Defaults to
# %LOCALAPPDATA%\ApplyPilot on Windows, ~/.local/share/applypilot elsewhere.
# APPLYPILOT_DATA_DIR=C:\Users\you\AppData\Local\ApplyPilot

# Port for the local service. The extension defaults to the same value.
# APPLYPILOT_PORT=8765

# Model provider. Only "gemini" is implemented today; "none" disables all model
# calls and runs the agent on deterministic matching alone.
# APPLYPILOT_MODEL_PROVIDER=gemini
# APPLYPILOT_MODEL_NAME=gemini-2.0-flash
